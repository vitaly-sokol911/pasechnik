# Заголовки безопасности для Netlify
#
# Этот файл читается Netlify при публикации и добавляется к каждому ответу
# сервера. Часть правил ниже браузер принимает ТОЛЬКО из настоящих HTTP-
# заголовков и игнорирует, если написать их мета-тегом в HTML.
#
# Файл должен лежать в корне публикуемой папки — рядом с index.html.
# Расширения у него нет, имя ровно "_headers".

/*
  # Запрет встраивать страницу в чужой фрейм (защита от кликджекинга).
  # Мета-тегом не работает — только заголовком.
  X-Frame-Options: DENY

  # Запрет браузеру угадывать тип файла вопреки заявленному.
  X-Content-Type-Options: nosniff

  # Сколько сведений об источнике перехода уходит на внешние сайты.
  Referrer-Policy: strict-origin-when-cross-origin

  # Отключаем браузерные разрешения, которые сайту не нужны.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

  # Открывать сайт только по HTTPS в течение года.
  # includeSubDomains и preload намеренно НЕ включены: их стоит добавлять,
  # только если вы контролируете все поддомены и готовы к необратимости.
  Strict-Transport-Security: max-age=31536000

  # Откуда странице разрешено грузить ресурсы. Повторяет мета-политику
  # внутри index.html и добавляет frame-ancestors, который в мета-теге
  # не действует. Если подключите Formspree или Яндекс.Метрику —
  # допишите их домены в script-src и connect-src.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

  # Сайт не индексируется поисковиками.
  X-Robots-Tag: noindex, nofollow
